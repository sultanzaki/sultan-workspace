# Backend only. Never use a VITE_ prefix for database or mail credentials.
# Supabase: use the Connect panel's direct URL or session pooler (port 5432).
# Use a dedicated database role with access to app_private in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
TRUST_PROXY_HOPS=0
# Non-local PostgreSQL always uses verified TLS. Optional Supabase CA file:
# DATABASE_CA_FILE=/secure/path/prod-supabase.cer
# file delivery is development only; inspect ignored .local/mail/*.json locally.
MAIL_TRANSPORT=file
MAIL_FROM=workspace@example.com
# Production requires SMTP; STARTTLS is mandatory unless SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Dedicated disposable local/CI database, never your live Supabase database:
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/sultan_test
